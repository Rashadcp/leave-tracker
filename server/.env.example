# Server Port (default: 5000 or 5123)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/leave-management?retryWrites=true&w=majority

# Gmail SMTP Configuration for Notifications
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
HR_NOTIFICATION_EMAIL=hr@yourcompany.com

# Public Portal URL / Domain (Used for email action button links)
# e.g. https://leave.yourcompany.com
DOMAIN=https://leave.yourcompany.com
